{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "aa-finance named-operation API",
  "description": "The authority for the boundary between the core and the UI, the command line and plugins (ADR-0023). Change this file first, then the code. Additive changes keep the version; removing or renaming a field or changing a type is breaking.",
  "api_version": "1",
  "global_errors": [
    "invalid_input",
    "unknown_operation",
    "database",
    "internal",
    "invalid_body",
    "foreign_database",
    "newer_database"
  ],
  "operations": {
    "open_book": {
      "summary": "Opens a new book: its base currency and its settings, written together. A book is opened once.",
      "input": {
        "type": "object",
        "properties": {
          "base_code": {
            "type": "string"
          },
          "base_scale": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18
          }
        },
        "required": [
          "base_code",
          "base_scale"
        ],
        "additionalProperties": false
      },
      "output": {
        "$ref": "#/$defs/DocRef"
      },
      "errors": [
        "book_already_open",
        "name_empty",
        "commodity_scale_invalid"
      ]
    },
    "settings": {
      "summary": "Reads the settings of the book.",
      "input": {
        "$ref": "#/$defs/Empty"
      },
      "output": {
        "$ref": "#/$defs/SettingsView"
      },
      "errors": [
        "missing_reference"
      ]
    },
    "set_base_currency": {
      "summary": "Changes the base currency. Refused once any entry exists.",
      "input": {
        "type": "object",
        "properties": {
          "commodity": {
            "$ref": "#/$defs/DocId"
          }
        },
        "required": [
          "commodity"
        ],
        "additionalProperties": false
      },
      "output": {
        "$ref": "#/$defs/DocRef"
      },
      "errors": [
        "base_currency_locked",
        "missing_reference",
        "conflict"
      ]
    },
    "create_commodity": {
      "summary": "Adds a currency or commodity with its scale.",
      "input": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "scale": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18
          }
        },
        "required": [
          "code",
          "scale"
        ],
        "additionalProperties": false
      },
      "output": {
        "$ref": "#/$defs/DocRef"
      },
      "errors": [
        "commodity_code_taken",
        "commodity_scale_invalid",
        "name_empty"
      ]
    },
    "create_account": {
      "summary": "Adds an account.",
      "input": {
        "$ref": "#/$defs/AccountInput"
      },
      "output": {
        "$ref": "#/$defs/DocRef"
      },
      "errors": [
        "name_empty",
        "account_name_taken",
        "account_parent_archived",
        "account_parent_kind_mismatch",
        "account_parent_cycle",
        "missing_reference"
      ]
    },
    "rename_account": {
      "summary": "Renames an account. Locked accounts are refused.",
      "input": {
        "type": "object",
        "properties": {
          "account": {
            "$ref": "#/$defs/DocId"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "account",
          "name"
        ],
        "additionalProperties": false
      },
      "output": {
        "$ref": "#/$defs/DocRef"
      },
      "errors": [
        "account_locked",
        "name_empty",
        "account_name_taken",
        "missing_reference",
        "conflict"
      ]
    },
    "set_account_archived": {
      "summary": "Archives or restores an account. Locked accounts are refused.",
      "input": {
        "type": "object",
        "properties": {
          "account": {
            "$ref": "#/$defs/DocId"
          },
          "archived": {
            "type": "boolean"
          }
        },
        "required": [
          "account",
          "archived"
        ],
        "additionalProperties": false
      },
      "output": {
        "$ref": "#/$defs/DocRef"
      },
      "errors": [
        "account_locked",
        "missing_reference",
        "conflict"
      ]
    },
    "create_contact": {
      "summary": "Adds a contact (a person, brand or business) that a line can point to. The name is unique, ignoring case and the Turkish i.",
      "input": {
        "$ref": "#/$defs/ContactInput"
      },
      "output": {
        "$ref": "#/$defs/DocRef"
      },
      "errors": [
        "name_empty",
        "contact_name_taken"
      ]
    },
    "post_entry": {
      "summary": "Posts a balanced entry (at least two lines), with the accounts and contacts it opens, in one write.",
      "input": {
        "$ref": "#/$defs/EntryInput"
      },
      "output": {
        "$ref": "#/$defs/DocRef"
      },
      "errors": [
        "entry_too_few_lines",
        "entry_unbalanced",
        "line_empty",
        "line_base_sign",
        "line_commodity_mismatch",
        "account_archived",
        "amount_invalid",
        "amount_too_precise",
        "amount_out_of_range",
        "rate_invalid",
        "rate_missing",
        "rate_base_conflict",
        "date_invalid",
        "missing_reference",
        "name_empty",
        "account_name_taken",
        "account_parent_archived",
        "account_parent_kind_mismatch",
        "contact_name_taken",
        "conflict"
      ]
    },
    "edit_entry": {
      "summary": "Replaces an entry with a new version. A deleted entry is refused; undo first.",
      "input": {
        "type": "object",
        "properties": {
          "entry": {
            "$ref": "#/$defs/DocId"
          },
          "input": {
            "$ref": "#/$defs/EntryInput"
          }
        },
        "required": [
          "entry",
          "input"
        ],
        "additionalProperties": false
      },
      "output": {
        "$ref": "#/$defs/DocRef"
      },
      "errors": [
        "entry_deleted",
        "entry_too_few_lines",
        "entry_unbalanced",
        "line_empty",
        "line_base_sign",
        "line_commodity_mismatch",
        "account_archived",
        "amount_invalid",
        "amount_too_precise",
        "amount_out_of_range",
        "rate_invalid",
        "rate_missing",
        "rate_base_conflict",
        "date_invalid",
        "missing_reference",
        "conflict",
        "name_empty",
        "account_name_taken",
        "account_parent_archived",
        "account_parent_kind_mismatch",
        "contact_name_taken"
      ]
    },
    "delete_entry": {
      "summary": "Deletes an entry as a tombstone revision; undo brings it back.",
      "input": {
        "type": "object",
        "properties": {
          "entry": {
            "$ref": "#/$defs/DocId"
          }
        },
        "required": [
          "entry"
        ],
        "additionalProperties": false
      },
      "output": {
        "$ref": "#/$defs/DocRef"
      },
      "errors": [
        "entry_deleted",
        "missing_reference",
        "conflict"
      ]
    },
    "undo": {
      "summary": "Goes one version back for a document. Repeats until the first version.",
      "input": {
        "type": "object",
        "properties": {
          "doc": {
            "$ref": "#/$defs/DocId"
          }
        },
        "required": [
          "doc"
        ],
        "additionalProperties": false
      },
      "output": {
        "$ref": "#/$defs/DocRef"
      },
      "errors": [
        "nothing_to_undo",
        "account_locked",
        "missing_reference",
        "conflict"
      ]
    },
    "redo": {
      "summary": "Brings back what the last undo took away, while nothing was changed after it.",
      "input": {
        "type": "object",
        "properties": {
          "doc": {
            "$ref": "#/$defs/DocId"
          }
        },
        "required": [
          "doc"
        ],
        "additionalProperties": false
      },
      "output": {
        "$ref": "#/$defs/DocRef"
      },
      "errors": [
        "nothing_to_redo",
        "account_locked",
        "missing_reference",
        "conflict"
      ]
    },
    "history": {
      "summary": "Lists every revision of a document in stored order.",
      "input": {
        "type": "object",
        "properties": {
          "doc": {
            "$ref": "#/$defs/DocId"
          }
        },
        "required": [
          "doc"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/HistoryItem"
        }
      },
      "errors": [
        "missing_reference"
      ]
    },
    "system_account": {
      "summary": "Finds the account the system opened under a key, such as rounding.",
      "input": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          }
        },
        "required": [
          "key"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "doc_id": {
            "$ref": "#/$defs/DocId"
          }
        },
        "required": [
          "doc_id"
        ],
        "additionalProperties": false
      },
      "errors": [
        "missing_reference"
      ]
    },
    "account": {
      "summary": "Reads an account.",
      "input": {
        "type": "object",
        "properties": {
          "account": {
            "$ref": "#/$defs/DocId"
          }
        },
        "required": [
          "account"
        ],
        "additionalProperties": false
      },
      "output": {
        "$ref": "#/$defs/AccountView"
      },
      "errors": [
        "missing_reference"
      ]
    },
    "contact": {
      "summary": "Reads a contact.",
      "input": {
        "type": "object",
        "properties": {
          "contact": {
            "$ref": "#/$defs/DocId"
          }
        },
        "required": [
          "contact"
        ],
        "additionalProperties": false
      },
      "output": {
        "$ref": "#/$defs/ContactView"
      },
      "errors": [
        "missing_reference"
      ]
    },
    "entry": {
      "summary": "Reads an entry.",
      "input": {
        "type": "object",
        "properties": {
          "entry": {
            "$ref": "#/$defs/DocId"
          }
        },
        "required": [
          "entry"
        ],
        "additionalProperties": false
      },
      "output": {
        "$ref": "#/$defs/EntryView"
      },
      "errors": [
        "missing_reference"
      ]
    },
    "scenario_list": {
      "summary": "Lists the built-in scenarios with their titles and the pack hash.",
      "input": {
        "type": "object",
        "properties": {
          "language": {
            "$ref": "#/$defs/Language"
          }
        },
        "required": [
          "language"
        ],
        "additionalProperties": false
      },
      "output": {
        "$ref": "#/$defs/ScenarioList"
      },
      "errors": []
    },
    "scenario_describe": {
      "summary": "The form of a scenario: its inputs in order with labels, for every platform to render. It holds no expressions.",
      "input": {
        "type": "object",
        "properties": {
          "scenario": {
            "type": "string"
          },
          "language": {
            "$ref": "#/$defs/Language"
          }
        },
        "required": [
          "scenario",
          "language"
        ],
        "additionalProperties": false
      },
      "output": {
        "$ref": "#/$defs/ScenarioForm"
      },
      "errors": [
        "missing_reference"
      ]
    },
    "scenario_draft": {
      "summary": "Turns a scenario and the user's values into an entry input, a preview and field errors. Writes nothing; save the entry with post_entry.",
      "input": {
        "$ref": "#/$defs/DraftInput"
      },
      "output": {
        "$ref": "#/$defs/Draft"
      },
      "errors": [
        "missing_reference"
      ]
    },
    "api_version": {
      "summary": "The version of this contract.",
      "input": {
        "$ref": "#/$defs/Empty"
      },
      "output": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          }
        },
        "required": [
          "version"
        ],
        "additionalProperties": false
      },
      "errors": []
    }
  },
  "$defs": {
    "DocId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "A UUID in lower case. Opaque: never parse it."
    },
    "RevisionId": {
      "$ref": "#/$defs/DocId",
      "description": "The id of one revision."
    },
    "Amount": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "description": "A decimal number as text, in the scale of its commodity. Never a JSON number."
    },
    "Rate": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?$",
      "description": "A positive decimal number as text."
    },
    "Date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "A civil Gregorian date, YYYY-MM-DD, no time zone."
    },
    "AccountKind": {
      "enum": [
        "asset",
        "liability",
        "equity",
        "income",
        "expense"
      ]
    },
    "ErrorCode": {
      "enum": [
        "projection_closed",
        "revision_immutable",
        "revision_parent_mismatch",
        "entry_too_few_lines",
        "entry_unbalanced",
        "account_archived",
        "commodity_scale_locked",
        "amount_out_of_range",
        "date_invalid",
        "commodity_scale_invalid",
        "commodity_code_taken",
        "account_parent_cycle",
        "line_commodity_mismatch",
        "account_commodity_locked",
        "revision_kind_mismatch",
        "amount_invalid",
        "amount_too_precise",
        "rate_invalid",
        "rate_missing",
        "line_base_sign",
        "rate_base_conflict",
        "line_empty",
        "nothing_to_undo",
        "nothing_to_redo",
        "entry_must_start_as_draft",
        "base_currency_locked",
        "settings_id_fixed",
        "book_already_open",
        "account_locked",
        "system_key_taken",
        "name_empty",
        "account_parent_archived",
        "account_parent_kind_mismatch",
        "account_name_taken",
        "entry_deleted_has_lines",
        "entry_deleted",
        "conflict",
        "database",
        "invalid_body",
        "missing_reference",
        "foreign_database",
        "internal",
        "newer_database",
        "unknown_operation",
        "invalid_input",
        "contact_name_taken",
        "contact_kind_fixed"
      ],
      "description": "Every stable code the API can return."
    },
    "Error": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "$ref": "#/$defs/ErrorCode"
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    },
    "DocRef": {
      "type": "object",
      "properties": {
        "doc_id": {
          "$ref": "#/$defs/DocId"
        },
        "revision_id": {
          "$ref": "#/$defs/RevisionId"
        }
      },
      "required": [
        "doc_id",
        "revision_id"
      ],
      "additionalProperties": false
    },
    "SettingsView": {
      "type": "object",
      "properties": {
        "base_commodity": {
          "$ref": "#/$defs/DocId"
        },
        "base_code": {
          "type": "string"
        },
        "base_scale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18
        }
      },
      "required": [
        "base_commodity",
        "base_code",
        "base_scale"
      ],
      "additionalProperties": false
    },
    "AccountInput": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "parent": {
          "oneOf": [
            {
              "$ref": "#/$defs/DocId"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/AccountKind"
        },
        "commodity": {
          "$ref": "#/$defs/DocId"
        }
      },
      "required": [
        "name",
        "kind",
        "commodity"
      ],
      "additionalProperties": false
    },
    "AccountView": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "parent": {
          "oneOf": [
            {
              "$ref": "#/$defs/DocId"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/AccountKind"
        },
        "commodity": {
          "$ref": "#/$defs/DocId"
        },
        "archived": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        },
        "system_key": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "parent",
        "kind",
        "commodity",
        "archived",
        "locked",
        "system_key"
      ],
      "additionalProperties": false
    },
    "LineInput": {
      "type": "object",
      "properties": {
        "account": {
          "$ref": "#/$defs/DocId"
        },
        "amount": {
          "$ref": "#/$defs/Amount"
        },
        "rate": {
          "oneOf": [
            {
              "$ref": "#/$defs/Rate"
            },
            {
              "type": "null"
            }
          ]
        },
        "base": {
          "oneOf": [
            {
              "$ref": "#/$defs/Amount"
            },
            {
              "type": "null"
            }
          ]
        },
        "contact": {
          "oneOf": [
            {
              "$ref": "#/$defs/DocId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "account",
        "amount"
      ],
      "additionalProperties": false
    },
    "EntryInput": {
      "type": "object",
      "properties": {
        "date": {
          "$ref": "#/$defs/Date"
        },
        "memo": {
          "type": [
            "string",
            "null"
          ]
        },
        "no": {
          "type": [
            "string",
            "null"
          ]
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LineInput"
          }
        },
        "create_accounts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NewAccount"
          },
          "description": "Accounts opened with the entry; all are written with it or none is."
        },
        "create_contacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NewContact"
          },
          "description": "Contacts opened with the entry; all are written with it or none is."
        }
      },
      "required": [
        "date",
        "lines"
      ],
      "additionalProperties": false
    },
    "LineView": {
      "type": "object",
      "properties": {
        "account": {
          "$ref": "#/$defs/DocId"
        },
        "commodity": {
          "$ref": "#/$defs/DocId"
        },
        "amount": {
          "$ref": "#/$defs/Amount"
        },
        "base": {
          "$ref": "#/$defs/Amount"
        },
        "rate": {
          "oneOf": [
            {
              "$ref": "#/$defs/Rate"
            },
            {
              "type": "null"
            }
          ]
        },
        "contact": {
          "oneOf": [
            {
              "$ref": "#/$defs/DocId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "account",
        "commodity",
        "amount",
        "base",
        "rate",
        "contact"
      ],
      "additionalProperties": false
    },
    "EntryView": {
      "type": "object",
      "properties": {
        "deleted": {
          "type": "boolean"
        },
        "date": {
          "$ref": "#/$defs/Date"
        },
        "memo": {
          "type": [
            "string",
            "null"
          ]
        },
        "no": {
          "type": [
            "string",
            "null"
          ]
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LineView"
          }
        }
      },
      "required": [
        "deleted",
        "date",
        "memo",
        "no",
        "lines"
      ],
      "additionalProperties": false
    },
    "Restore": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "undo",
            "redo"
          ]
        },
        "from": {
          "$ref": "#/$defs/RevisionId"
        }
      },
      "required": [
        "kind",
        "from"
      ],
      "additionalProperties": false
    },
    "HistoryItem": {
      "type": "object",
      "properties": {
        "revision_id": {
          "$ref": "#/$defs/RevisionId"
        },
        "parent_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/RevisionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "author_id": {
          "$ref": "#/$defs/DocId"
        },
        "created_at_ms": {
          "type": "integer"
        },
        "restore": {
          "oneOf": [
            {
              "$ref": "#/$defs/Restore"
            },
            {
              "type": "null"
            }
          ]
        },
        "head": {
          "type": "boolean",
          "description": "The revision the document shows now."
        },
        "conflict": {
          "type": "boolean",
          "description": "On a branch that lost the race (written elsewhere): not on the way from the head back to the first revision. Kept for the user to see."
        }
      },
      "required": [
        "revision_id",
        "parent_id",
        "author_id",
        "created_at_ms",
        "restore",
        "head",
        "conflict"
      ],
      "additionalProperties": false
    },
    "Empty": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "ContactKind": {
      "enum": [
        "individual",
        "brand",
        "business"
      ]
    },
    "ContactInput": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ContactKind"
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "additionalProperties": false
    },
    "ContactView": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ContactKind"
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "additionalProperties": false
    },
    "NewAccount": {
      "description": "An account the entry opens in the same write, under an id the caller chose (a scenario draft picks it).",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/DocId"
        },
        "account": {
          "$ref": "#/$defs/AccountInput"
        }
      },
      "required": [
        "id",
        "account"
      ],
      "additionalProperties": false
    },
    "NewContact": {
      "description": "A contact the entry opens in the same write, under an id the caller chose.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/DocId"
        },
        "contact": {
          "$ref": "#/$defs/ContactInput"
        }
      },
      "required": [
        "id",
        "contact"
      ],
      "additionalProperties": false
    },
    "Language": {
      "description": "The language of texts a scenario returns.",
      "enum": [
        "tr",
        "en"
      ]
    },
    "ScenarioSummary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "additionalProperties": false
    },
    "ScenarioList": {
      "type": "object",
      "properties": {
        "pack": {
          "type": "string"
        },
        "hash": {
          "type": "string",
          "description": "SHA-256 of the pack text, lower-case hex.",
          "pattern": "^[0-9a-f]{64}$"
        },
        "scenarios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScenarioSummary"
          }
        }
      },
      "required": [
        "pack",
        "hash",
        "scenarios"
      ],
      "additionalProperties": false
    },
    "FormOption": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false
    },
    "FormInput": {
      "description": "One input of a scenario form (docs/foundation/scenario-format.md). Only the fields of its type are present.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "enum": [
            "amount",
            "account",
            "rate",
            "contact",
            "choice",
            "lines",
            "date",
            "text"
          ]
        },
        "label": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "of": {
          "type": "string",
          "description": "amount: the account input of its commodity; rate: the account input or list.column it values."
        },
        "kinds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AccountKind"
          }
        },
        "new": {
          "type": "boolean",
          "description": "account: a typed new name is allowed."
        },
        "default_system": {
          "type": "string",
          "description": "account: the system account used when the input is empty."
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FormOption"
          }
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FormInput"
          }
        },
        "default": {
          "type": "string",
          "description": "amount: the amount input it copies when not given."
        },
        "show_if_commodity_differs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "max": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "name",
        "type",
        "label",
        "required"
      ],
      "additionalProperties": false
    },
    "ScenarioForm": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FormInput"
          }
        }
      },
      "required": [
        "id",
        "title",
        "inputs"
      ],
      "additionalProperties": false
    },
    "DraftInput": {
      "type": "object",
      "properties": {
        "scenario": {
          "type": "string"
        },
        "language": {
          "$ref": "#/$defs/Language"
        },
        "inputs": {
          "type": "object",
          "description": "Input name to value, in the shapes of docs/foundation/scenario-format.md: amounts and rates as canonical text, accounts and contacts as {\"id\": ...} or {\"new\": \"name\"}, a choice as its option id, lines as a list of rows."
        }
      },
      "required": [
        "scenario",
        "language",
        "inputs"
      ],
      "additionalProperties": false
    },
    "Preview": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "vars": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "vars",
        "text"
      ],
      "additionalProperties": false
    },
    "FieldError": {
      "type": "object",
      "properties": {
        "field": {
          "type": [
            "string",
            "null"
          ],
          "description": "An input name, list.row.column for a row, or null for the draft as a whole."
        },
        "code": {
          "type": "string",
          "description": "required, invalid, unknown, unknown_field, account_kind, account_archived, same_account, rate_needed, too_long, calculation, too_few_lines, mixed_commodities, or the message key of a failed pack check."
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "field",
        "code",
        "text"
      ],
      "additionalProperties": false
    },
    "Draft": {
      "description": "Either an entry with its preview and no errors, or errors with a null entry and preview. The entry goes unchanged to post_entry.",
      "type": "object",
      "properties": {
        "entry": {
          "oneOf": [
            {
              "$ref": "#/$defs/EntryInput"
            },
            {
              "type": "null"
            }
          ]
        },
        "preview": {
          "oneOf": [
            {
              "$ref": "#/$defs/Preview"
            },
            {
              "type": "null"
            }
          ]
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldError"
          }
        }
      },
      "required": [
        "entry",
        "preview",
        "errors"
      ],
      "additionalProperties": false
    }
  }
}
