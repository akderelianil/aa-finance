# Kopyala: .env  (gitignore'da; asla commit edilmez). Değerleri buraya yaz, kodda/dokümanda değil.
# Supabase Management API / CLI / MCP için kişisel erişim token'ı (sbp_...)
SUPABASE_ACCESS_TOKEN=
# Supabase proje ref (gizli değil, kolaylık için)
SUPABASE_PROJECT_REF=ckwigjohcdsfqglmmzdq
# Edge Function'ların direkt Postgres bağlantısı (yalnız CLI/yerel testlerde; fonksiyonlarda Supabase secret olarak tanımlı)
SUPABASE_DB_URL=
# service_role anahtarı: SADECE sunucu/CLI tarafı. Frontend'e (web/.env.local) asla girmez.
SUPABASE_SERVICE_ROLE_KEY=
# Dev test account password (scripts/dev/seed-test-account.mjs writes it)
DEV_TEST_PASSWORD=
