#!/bin/sh
# Runs the local quality gate before each commit: repo scripts, test catalog and the Rust workspace.
# Skip once with: SKIP_VERIFY=1 git commit ...
[ "${SKIP_VERIFY:-0}" = "1" ] && exit 0
cd "$(git rev-parse --show-toplevel)" || exit 1
npm run --silent verify || exit 1
if [ -f Cargo.toml ]; then
  cargo test --workspace --quiet || exit 1
fi
