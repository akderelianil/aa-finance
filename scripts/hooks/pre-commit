#!/bin/sh
# Runs the local quality gate before each commit. Rust tests only when src-tauri/ is staged.
# Skip once with: SKIP_VERIFY=1 git commit ...
[ "${SKIP_VERIFY:-0}" = "1" ] && exit 0
cd "$(git rev-parse --show-toplevel)" || exit 1
npm run --silent verify:web || exit 1
if git diff --cached --name-only | grep -q '^src-tauri/'; then
  npm run --silent verify:rust || exit 1
fi
