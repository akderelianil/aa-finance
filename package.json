{
  "name": "aa-finance",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "oxlint src",
    "test": "node --test --disable-warning=ExperimentalWarning \"{src,scripts}/**/*.test.ts\"",
    "test:coverage": "node --test --disable-warning=ExperimentalWarning --experimental-test-coverage --test-coverage-lines=90 \"{src,scripts}/**/*.test.ts\"",
    "verify:web": "npm run test:coverage && tsc --noEmit && npm run lint",
    "verify:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "verify": "npm run verify:web && npm run verify:rust",
    "hooks:install": "sh scripts/hooks/install.sh",
    "tauri": "tauri",
    "seed": "node --disable-warning=ExperimentalWarning scripts/dev/seed-local.ts",
    "bench": "node --disable-warning=ExperimentalWarning scripts/dev/bench.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-table": "^9.2.8",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "i18next": "^26.4.4",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-router": "^8.4.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.81.0",
    "shadcn": "^4.21.4",
    "typescript": "~6.0.2",
    "vite": "^8.3.4"
  }
}
