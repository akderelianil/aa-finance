{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/graphify.cmd hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/graphify.cmd hook-guard read --strict",
            "timeout": 10
          }
        ]
      }
    ]
  }
}